    },
    "Das Netzteil liefert weniger Strom, als der Mac gerade braucht, deshalb leert sich der Akku trotz Kabel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Netzteil liefert weniger Strom, als der Mac gerade braucht, deshalb leert sich der Akku trotz Kabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The power adapter delivers less power than your Mac needs right now, so the battery drains even though it is plugged in."
          }
        }
      }
    },
