          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SSD's spare capacity has dropped to %1$lld%%, and wear is at %2$lld%%. Back up important data regularly."
          }
        }
      }
    },
    "Die SSD hat laut Selbstdiagnose %lld %% ihrer geplanten Lebensdauer verbraucht, die Reserve liegt bei %lld %%. Sichere wichtige Daten regelmäßig." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
