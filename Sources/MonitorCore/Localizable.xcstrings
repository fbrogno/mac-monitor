    },
    "Beende Apps mit hohem Verbrauch, die größten stehen unten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende Apps mit hohem Verbrauch, die größten stehen unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit apps with high usage; the biggest are listed below."
          }
        }
      }
    },
    "Beende die App, wenn du sie gerade nicht brauchst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende die App, wenn du sie gerade nicht brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit the app if you don't need it right now."
          }
        }
      }
    },
    "Beende grafikintensive Apps, Spiele oder Videoexporte, die du nicht brauchst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende grafikintensive Apps, Spiele oder Videoexporte, die du nicht brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit graphics-intensive apps, games or video exports you don't need."
          }
        }
      }
    },
    "Beende rechenintensive Apps, die größten Verbraucher stehen unten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende rechenintensive Apps, die größten Verbraucher stehen unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit compute-heavy apps; the biggest consumers are listed below."
          }
        }
      }
    },
    "Beende, was du gerade nicht brauchst. Die größten Verbraucher stehen unten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende, was du gerade nicht brauchst. Die größten Verbraucher stehen unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit what you don't need right now. The biggest consumers are listed below."
          }
        }
      }
    },
    "Beendet mit Code %d." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet mit Code %d."
