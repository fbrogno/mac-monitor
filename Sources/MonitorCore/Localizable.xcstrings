    "Der Akku fasst nach %lld Ladezyklen nur noch %@ %% seiner ursprünglichen Kapazität. Die Laufzeit ist entsprechend kürzer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku fasst nach %1$lld Ladezyklen nur noch %2$@ %% seiner ursprünglichen Kapazität. Die Laufzeit ist entsprechend kürzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After %1$lld charge cycles, the battery holds only %2$@%% of its original capacity. Battery life is shorter accordingly."
          }
        }
