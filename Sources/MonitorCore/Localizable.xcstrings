        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exited with code %d."
          }
        }
      }
    },
    "Bei Browsern helfen auch weniger offene Tabs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Browsern helfen auch weniger offene Tabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In browsers, fewer open tabs help too."
          }
        }
      }
    },
    "Bei wenig freiem Platz fehlen macOS die Reserven für Swap, Updates und Caches. Unter etwa 10 % wird der Mac spürbar langsamer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei wenig freiem Platz fehlen macOS die Reserven für Swap, Updates und Caches. Unter etwa 10 % wird der Mac spürbar langsamer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When free space is low, macOS lacks room for swap, updates and caches. Below about 10%, your Mac gets noticeably slower."
          }
        }
      }
    },
    "Bis dahin hilft es, den Mac nicht dauerhaft heiß oder bei 0 % zu betreiben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis dahin hilft es, den Mac nicht dauerhaft heiß oder bei 0 % zu betreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until then, avoid running your Mac hot for long or down to 0%."
          }
        }
      }
    },
    "Brauchst du ihn nicht mehr, beende ihn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauchst du ihn nicht mehr, beende ihn."
