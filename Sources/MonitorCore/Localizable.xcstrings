          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarting apps that use a lot of memory frees it right away."
          }
        }
      }
    },
    "Arbeitet er absichtlich, warte ab oder schalte die Warnung stumm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
