    "Eigene Regeln melden nur das, was du in ihren Aktionen festlegst. Programme des Systems und MacMonitor selbst werden nie beendet oder gedrosselt. „Prozess beenden“ fragt auf Wunsch vorher nach." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Regeln melden nur das, was du in ihren Aktionen festlegst. Programme des Systems und MacMonitor selbst werden nie beendet oder gedrosselt. „Prozess beenden“ fragt auf Wunsch vorher nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom rules only do what you set in their actions. System processes and MacMonitor itself are never quit or throttled. “Quit process” can ask first if you like."
          }
        }
      }
    },
