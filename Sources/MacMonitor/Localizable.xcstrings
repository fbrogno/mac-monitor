          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannt wird ein gespiegelter Bildschirm, etwa ein Beamer im Spiegelmodus. Eine Bildschirmfreigabe in Zoom oder Teams und Folien im Vollbild erkennt MacMonitor nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mirrored display is detected, such as a projector in mirroring mode. MacMonitor doesn’t detect screen sharing in Zoom or Teams, or full-screen slides."
          }
        }
      }
