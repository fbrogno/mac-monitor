    "Meldet, wenn auf dem Startvolume der freie Platz knapp wird." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn auf dem Startvolume der freie Platz knapp wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when free space on the startup volume runs low."
          }
        }
      }
    },
    "Meldet, wenn auf einem weiteren Volume, etwa einer externen Platte, der Platz knapp wird. Nutzt dieselben Schwellen wie „Festplatte voll“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn auf einem weiteren Volume, etwa einer externen Platte, der Platz knapp wird. Nutzt dieselben Schwellen wie „Festplatte voll“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when space runs low on another volume, such as an external drive. Uses the same thresholds as “Disk full”."
          }
        }
      }
    },
    "Meldet, wenn der Akku deutlich an Kapazität verloren hat. Erinnert höchstens einmal pro Woche." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn der Akku deutlich an Kapazität verloren hat. Erinnert höchstens einmal pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the battery has lost a lot of capacity. Reminds you at most once a week."
          }
        }
      }
    },
    "Meldet, wenn der Akku trotz angeschlossenem Netzteil weiter entlädt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn der Akku trotz angeschlossenem Netzteil weiter entlädt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the battery keeps discharging even though the power adapter is connected."
          }
        }
      }
    },
    "Meldet, wenn der Mac keine Internetverbindung mehr hat, und wenn sie zurück ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn der Mac keine Internetverbindung mehr hat, und wenn sie zurück ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the Mac loses its internet connection, and when it’s back."
          }
        }
      }
    },
    "Meldet, wenn die CPU dauerhaft zu heiß ist, noch bevor macOS drosselt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn die CPU dauerhaft zu heiß ist, noch bevor macOS drosselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the CPU stays too hot, before macOS throttles it."
          }
        }
      }
    },
    "Meldet, wenn die CPU des ganzen Macs lange ausgelastet ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn die CPU des ganzen Macs lange ausgelastet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the CPU of the whole Mac stays busy for a long time."
          }
        }
      }
    },
    "Meldet, wenn die Grafikeinheit dauerhaft stark ausgelastet ist. Standardmäßig aus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn die Grafikeinheit dauerhaft stark ausgelastet ist. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the GPU stays heavily loaded. Off by default."
          }
        }
      }
    },
    "Meldet, wenn die SSD stark abgenutzt ist oder ihre Reserve schrumpft. Erinnert höchstens einmal pro Woche." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn die SSD stark abgenutzt ist oder ihre Reserve schrumpft. Erinnert höchstens einmal pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when the SSD is heavily worn or its spare capacity shrinks. Reminds you at most once a week."
          }
        }
      }
    },
    "Meldet, wenn ein Lüfter dauerhaft fast auf voller Drehzahl läuft." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn ein Lüfter dauerhaft fast auf voller Drehzahl läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when a fan keeps running at nearly full speed."
          }
        }
      }
    },
    "Meldet, wenn ein Programm im Akkubetrieb im Schnitt der letzten 5 Minuten viel Strom zieht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet, wenn ein Programm im Akkubetrieb im Schnitt der letzten 5 Minuten viel Strom zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts you when an app draws a lot of power on battery, averaged over the last 5 minutes."
          }
        }
