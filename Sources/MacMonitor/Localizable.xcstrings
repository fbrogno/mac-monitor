    "Alle gespeicherten Messwerte, Ereignisse und Prozess-Ranglisten werden entfernt. Das lässt sich nicht rückgängig machen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gespeicherten Messwerte, Ereignisse und Prozess-Ranglisten werden entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All stored measurements, events and process rankings will be removed. This can't be undone."
          }
        }
      }
    },
